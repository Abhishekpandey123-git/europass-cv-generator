# OpenRouter API key for AI-powered CV extraction.
OPENROUTER_API_KEY=
# Any OpenRouter model slug. openrouter/auto chooses a suitable model automatically.
OPENROUTER_MODEL=openrouter/auto
# Optional metadata sent to OpenRouter.
APP_URL=http://127.0.0.1:8000
APP_NAME=Europass PDF to XML Converter
MAX_UPLOAD_MB=15
