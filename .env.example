# Copy this file to .env and fill in the values.

# Password for the staff dashboard and editor. Leave empty only on your own computer.
ADMIN_PASSWORD=

# Keys the client's website uses to send data (header X-API-Key). Several allowed, comma-separated.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# The address people use to reach this service (used in links sent back to the website).
PUBLIC_URL=http://localhost:8000

# Where to listen. Use HOST=0.0.0.0 on a server.
HOST=127.0.0.1
PORT=8000
